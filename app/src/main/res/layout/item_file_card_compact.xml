<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Colored dot representing file type -->
    <View
        android:id="@+id/fileTypeDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_compact_dot" />

    <TextView
        android:id="@+id/fileTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Acadex.Headline"
        android:textSize="14sp"
        tools:text="Calculus Finals Reviewer" />

    <TextView
        android:id="@+id/subjectBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="Math" />
</LinearLayout>
