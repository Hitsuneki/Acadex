<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white">

    <ScrollView
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Book Cover Section / Premium Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/navy_primary"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_book"
                        app:tint="@color/text_on_navy" />

                    <TextView
                        android:id="@+id/bookTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Acadex.Headline"
                        android:textColor="@color/text_on_navy"
                        android:textSize="20sp"
                        tools:text="Pride and Prejudice" />

                    <TextView
                        android:id="@+id/bookAuthors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Acadex.Body"
                        android:textColor="@color/border_light"
                        android:textSize="14sp"
                        tools:text="Jane Austen" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Metadata Info Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:baselineAligned="false">

                <!-- Language Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Language"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/metaLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textStyle="bold"
                            android:textColor="@color/navy_primary"
                            android:textSize="14sp"
                            tools:text="English" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Downloads Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Downloads"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/metaDownloads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textStyle="bold"
                            android:textColor="@color/navy_primary"
                            android:textSize="14sp"
                            tools:text="45.2k" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Subject Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="16dp"
                android:text="Genres / Subjects"
                android:textAppearance="@style/TextAppearance.Acadex.Headline"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/subjectChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

            <!-- Action Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="40dp">

                <!-- Read Button (Primary Electric Blue) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRead"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Read Book"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/accent_blue"
                    app:cornerRadius="12dp"
                    app:iconGravity="textStart"
                    app:icon="@drawable/ic_book"
                    app:iconTint="@color/white" />

                <!-- Secondary Toggles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Save Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Save"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        app:strokeColor="@color/navy_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_bookmark_outline"
                        app:iconTint="@color/navy_primary"
                        app:iconSize="18dp" />

                    <!-- Download Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownload"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/download"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        app:strokeColor="@color/navy_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_download"
                        app:iconTint="@color/navy_primary"
                        app:iconSize="18dp" />

                    <!-- Share Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Share"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        app:strokeColor="@color/navy_primary"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_menu_share"
                        app:iconTint="@color/navy_primary"
                        app:iconSize="18dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- Error State Stub -->
    <ViewStub
        android:id="@+id/errorStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout="@layout/layout_error_state" />
</FrameLayout>
