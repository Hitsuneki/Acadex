<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ClassHub" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="android:statusBarColor">@color/header_background</item>
        <item name="android:navigationBarColor">@color/bottom_nav_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background_screen</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Theme.ClassHub" parent="Base.Theme.ClassHub" />

    <style name="Widget.ClassHub.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.ClassHub.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.ClassHub.Button.Outlined.SeeAll" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/chip_stroke</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.ClassHub.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ClassHub.WelcomeTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_on_welcome</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ClassHub.WelcomeSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_on_welcome_secondary</item>
    </style>

    <style name="TextAppearance.ClassHub.StatValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_on_welcome</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ClassHub.StatLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_on_welcome_secondary</item>
    </style>
</resources>
